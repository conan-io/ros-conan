include(default)

[settings]
compiler.cppstd=17

# python_version tracks the Python running Conan (i.e. the consumer's interpreter).
# Override with profiles/ros-py3XX to pin a specific version explicitly.

[options]
ros-kilted/*:python_version={{ platform.python_version_tuple()[0] }}.{{ platform.python_version_tuple()[1] }}

[tool_requires]
cmake/3.29.3

{% if platform.system() == "Linux" %}
[conf]
tools.system.package_manager:mode=install
tools.system.package_manager:sudo=True
{% endif %}
