include(default)

[settings]
compiler.cppstd=17

# Base profile: python_version defaults to the recipe value (3.12). Use a
# profiles/ros-py3XX profile to pin a specific interpreter; the recipe derives
# cpython-portable from it, so this single option fixes the whole Python toolchain.

[tool_requires]
cmake/3.29.3

{% if platform.system() == "Linux" %}
[conf]
tools.system.package_manager:mode=install
tools.system.package_manager:sudo=True
{% endif %}
