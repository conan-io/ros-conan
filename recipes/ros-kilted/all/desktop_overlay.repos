# Packages required by ros2/variants `desktop` (0.12.0) that are absent from
# the official ros2.repos snapshot.  Versions are taken from the official
# Kilted rosdistro (ros/rosdistro kilted/distribution.yaml).
repositories:
  ros/angles:
    type: git
    url: https://github.com/ros/angles.git
    version: 1.16.1

  ros-perception/depthimage_to_laserscan:
    type: git
    url: https://github.com/ros-perception/depthimage_to_laserscan.git
    version: 2.5.1

  ros-drivers/joystick_drivers:
    type: git
    url: https://github.com/ros-drivers/joystick_drivers.git
    version: 3.3.0

  ros-perception/pcl_msgs:
    type: git
    url: https://github.com/ros-perception/pcl_msgs.git
    version: ros2

  ros-perception/perception_pcl:
    type: git
    url: https://github.com/ros-perception/perception_pcl.git
    version: 2.8.0

  ros2/teleop_twist_joy:
    type: git
    url: https://github.com/ros2/teleop_twist_joy.git
    version: 2.6.5

  ros2/teleop_twist_keyboard:
    type: git
    url: https://github.com/ros2/teleop_twist_keyboard.git
    version: 2.4.1

  ros-visualization/rqt_common_plugins:
    type: git
    url: https://github.com/ros-visualization/rqt_common_plugins.git
    version: 1.2.0
