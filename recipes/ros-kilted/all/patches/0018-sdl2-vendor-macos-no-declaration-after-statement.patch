--- src/joystick_drivers/sdl2_vendor/CMakeLists.txt
+++ src/joystick_drivers/sdl2_vendor/CMakeLists.txt
@@ -8,6 +8,11 @@ find_package(ament_cmake REQUIRED)

+# SDL2-2.0.20 enables -Wdeclaration-after-statement for C (including .m files).
+# Apple clang 16+ treats it as an error; suppress it in the ExternalProject build.
+if(APPLE)
+  set(_sdl_c_flags "-Wno-declaration-after-statement")
+endif()
+
 if(NOT FORCE_BUILD_VENDOR_PKG)
   list(INSERT CMAKE_MODULE_PATH 0 "${CMAKE_CURRENT_SOURCE_DIR}/cmake/Modules")
   find_package(sdl2_custom QUIET)
@@ -26,6 +31,7 @@ if(NOT SDL2_FOUND)
       -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
       -DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
       -DCMAKE_CXX_FLAGS=${CMAKE_CXX_FLAGS}
+      -DCMAKE_C_FLAGS=${_sdl_c_flags}
       -DSDL_ATOMIC=OFF
       -DSDL_AUDIO=OFF
       -DSDL_VIDEO=ON     # On, needed to link on Windows
